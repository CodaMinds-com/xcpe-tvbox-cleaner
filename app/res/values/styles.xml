<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Remote-friendly button: big target, no shouting capitals, bright focused face from btn_tv.xml. -->
    <style name="TvButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:background">@drawable/btn_tv</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
