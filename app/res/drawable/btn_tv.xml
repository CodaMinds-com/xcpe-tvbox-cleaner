<?xml version="1.0" encoding="utf-8"?>
<!-- Button face. The focused state must be obvious from across the room: the remote has no pointer. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#162224"/>
            <stroke android:width="1dp" android:color="#243436"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#7FE3D6"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EC4B6"/>
            <stroke android:width="3dp" android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22393C"/>
            <stroke android:width="1dp" android:color="#3C5558"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
