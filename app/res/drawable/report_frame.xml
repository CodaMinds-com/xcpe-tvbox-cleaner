<?xml version="1.0" encoding="utf-8"?>
<!-- Frame around the report. Lights up when the remote's focus is on it, so "press down to scroll" is visible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B1416"/>
            <stroke android:width="3dp" android:color="#2EC4B6"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B1416"/>
            <stroke android:width="1dp" android:color="#22393C"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
