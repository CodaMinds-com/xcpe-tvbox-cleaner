<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:minHeight="56dp">
    <CheckBox android:id="@+id/row_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:focusable="false" android:clickable="false" android:layout_marginEnd="14dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textColor="#E7EEEC"/>
        <TextView android:id="@+id/row_reason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="#A3B3B0" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/row_warning" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#F2C26B" android:layout_marginTop="2dp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
